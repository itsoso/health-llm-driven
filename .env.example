# ============================================================
# Health App - Docker Compose Environment Variables
# ============================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Required variables are marked with [REQUIRED].
# Optional variables have sensible defaults.
# ============================================================

# ─── Security ─────────────────────────────────────────────
# [REQUIRED] JWT signing key. Must be at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Encryption key for stored device credentials (Garmin, etc.)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DEVICE_ENCRYPTION_KEY=

# ─── LLM / AI Provider ───────────────────────────────────
# [REQUIRED] API key for the LLM provider (OpenAI, compatible API, etc.)
LLM_API_KEY=

# Base URL override (for OpenAI-compatible proxies or local endpoints)
# LLM_BASE_URL=https://api.openai.com/v1

# Model names
LLM_MODEL=gpt-4o-mini
# LLM_VISION_MODEL=qwen3-vl-flash

# ─── Alibaba Cloud Model Studio / TokenPlan AIGC (optional) ──
# Images use the separate Model Studio pay-as-you-go API key below. Short videos
# default to TokenPlan HappyHorse and reuse TOKENPLAN_API_KEY (sk-sp- prefix).
# DASHSCOPE_AIGC_API_KEY=
# DASHSCOPE_AIGC_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# DASHSCOPE_AIGC_IMAGE_MODEL=wan2.7-image
# DASHSCOPE_AIGC_TEXT_TO_VIDEO_MODEL=wan2.7-t2v
# DASHSCOPE_AIGC_IMAGE_TO_VIDEO_MODEL=wan2.7-i2v
# AIGC_VIDEO_PROVIDER=tokenplan
# TOKENPLAN_AIGC_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/api/v1
# TOKENPLAN_AIGC_TEXT_TO_VIDEO_MODEL=happyhorse-1.1-t2v
# TOKENPLAN_AIGC_IMAGE_TO_VIDEO_MODEL=happyhorse-1.1-i2v
# Provider-side cost and task-API safety limits. Keep global active jobs and
# poll interval aligned so the account stays under Model Studio task API QPS.
# DASHSCOPE_AIGC_MAX_ACTIVE_JOBS_PER_USER=2
# DASHSCOPE_AIGC_MAX_ACTIVE_JOBS_GLOBAL=20
# DASHSCOPE_AIGC_MAX_DISPATCHES_PER_USER_PER_DAY=5
# DASHSCOPE_AIGC_POLL_MIN_INTERVAL_SECONDS=6
# DASHSCOPE_AIGC_GLOBAL_POLL_MIN_INTERVAL_SECONDS=1
# For image-to-video, Xiaoba gives Wan a short-lived HTTPS source capability.
# SITE_BASE_URL=https://health.example.com

# ─── Ollama (local LLM, uncomment to use) ─────────────────
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3

# ─── OpenClaw (AI chatbot service) ────────────────────────
# OPENCLAW_BASE_URL=https://bot.executor.life/v1
# OPENCLAW_API_KEY=
# OPENCLAW_MODEL=openclaw:main

# ─── PostgreSQL ───────────────────────────────────────────
POSTGRES_DB=health_db
POSTGRES_USER=health_user
POSTGRES_PASSWORD=health_pass

# Expose PostgreSQL on this host port (default 5432)
# POSTGRES_PORT=5432

# ─── Redis ────────────────────────────────────────────────
# Expose Redis on this host port (default 6379)
# REDIS_PORT=6379

# ─── Service Ports ────────────────────────────────────────
# Host ports for frontend and backend
FRONTEND_PORT=3000
BACKEND_PORT=8000

# ─── Application ──────────────────────────────────────────
# Environment: development | production
APP_ENV=production

# CORS allowed origins (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:3000

# Default invite code for user registration
DEFAULT_INVITE_CODE=LLM

# Invited phone registration rollout states:
# - false/false = legacy_only：仅本地/短期兼容，不用于生产安全回滚
# - true/false = ota_compatibility：旧 Mobile 兼容窗
# - true/true = enforced：生产完全强制邀请制
# - false/true = rollback_closed：关闭新注册，保留老用户登录
REGISTRATION_INVITATION_ROLLOUT_ENABLED=false
REGISTRATION_INVITATION_ENFORCEMENT_ENABLED=false
# 生产启用任一开关时必须提供至少 32 UTF-8 bytes 的独立随机 key。
REGISTRATION_INVITATION_DIGEST_KEY=
# manual 不发邀请短信，由管理员手工转发；sms 才要求下方专用配置。
REGISTRATION_INVITATION_DELIVERY_MODE=manual

# sms 模式：专用 key 为空时复用 ALIYUN_ACCESS_KEY_ID/SECRET；若填写，
# ID 与 SECRET 必须成对设置。邀请签名/模板不得与 OTP 相同。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# 生产邀请值不得与其相同；manual 模式可保持为空。
REGISTRATION_INVITATION_SMS_SIGN_NAME=
REGISTRATION_INVITATION_SMS_TEMPLATE_CODE=

# ─── Garmin Connect (optional) ────────────────────────────
# GARMIN_EMAIL=
# GARMIN_PASSWORD=
# GARMIN_ENCRYPTION_KEY=

# ─── Weather & Air Quality (optional) ─────────────────────
# QWeather API (https://dev.qweather.com/)
# QWEATHER_API_KEY=
# QWEATHER_API_TYPE=free
# QWEATHER_API_HOST=

# Air Quality (https://aqicn.org/data-platform/token/)
# AQICN_API_TOKEN=

# ─── Aliyun Smart Search (optional) ──────────────────────
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=

# ─── WeChat Mini Program (optional) ──────────────────────
# WECHAT_APPID=
# WECHAT_SECRET=

# === MCP Server ===
MCP_API_TOKEN=           # Health API JWT token for MCP Server authentication
