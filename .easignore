# EAS packages from the repository root. Keep only the mobile app and the
# apps/watch sources required by watch build profiles.
/.git
/.ruff_cache
/.pytest_cache
/.github
/.agents
/.cursor
/htmlcov
/backend
/frontend
/packages
/docs
/design
/apps/mac
/apps/rokid-pushup-glasses

# Continuous Native Generation recreates these directories in EAS. Local
# patches and the server-hosted Rokid APK are not inputs to the iOS build.
/mobile/ios
/mobile/android
/mobile/patches
/mobile/assets/rokid
