    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "life.executor.health"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "用于语音输入、健康记录听写和小巴对话",
          "speechRecognitionPermission": "识别你的语音,和小巴连续对话"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用于查询天气、空气质量；你主动选择时单次读取位置，确认城市后保存为记录足迹，不持续追踪",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0",
            "privacyManifestAggregationEnabled": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A8F8F"
        }
      ],
      "@sentry/react-native",
      "expo-font",
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "用于你主动选择餐盘、补剂标签、检查报告或健康相关图片，生成记录草稿和健康分析",
          "savePhotosPermission": "用于你主动保存小巴对话中的图片、健康报告或分享截图到照片图库"
        }
      ],
      "expo-web-browser",
      "./plugins/withHealthKitCleanup",
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false,
          "healthSharePermission": "用于读取 Apple Watch / RingConn / Oura 等设备的健康数据",
          "healthUpdatePermission": "仅在你确认后将健康记录写入 Apple Health"
        }
      ],
      "./plugins/withIosSupportedOrientations"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "911ea84f-bc7e-4a12-90cf-33966b6f7398"
      }
    },
    "owner": "itsoso",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/911ea84f-bc7e-4a12-90cf-33966b6f7398"
    }
  }
}
