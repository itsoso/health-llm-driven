{
  "expo": {
    "name": "HealthPilot",
    "slug": "health-pilot",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["mobile", "health"],
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A8F8F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "life.executor.health",
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.healthkit": true
      },
      "infoPlist": {
        "CFBundleDisplayName": "阿衡",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSFaceIDUsageDescription": "使用 Face ID 保护您的健康数据",
        "NSSiriUsageDescription": "使用 Siri 语音快速记录或分析健康数据",
        "NSPhotoLibraryUsageDescription": "用于你主动选择餐盘、补剂标签、检查报告或健康相关图片，生成记录草稿和健康分析",
        "NSPhotoLibraryAddUsageDescription": "用于你主动保存健康报告、截图或导出图片到照片图库",
        "NSCameraUsageDescription": "拍摄食物或健康数据进行分析",
        "NSMicrophoneUsageDescription": "用于语音输入、健康记录听写和阿衡对话",
        "NSSpeechRecognitionUsageDescription": "识别你的语音,和阿衡连续对话",
        "NSLocationWhenInUseUsageDescription": "用你当前位置查天气、空气质量,给出更贴合的建议",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "跑步过程中需要后台定位才能持续记录路线和配速,息屏 / 切换到其他 App 时不中断",
        "NSHealthShareUsageDescription": "用于读取 Apple Watch / RingConn / Oura 等设备写入的健康数据,生成个性化健康分析",
        "UIBackgroundModes": ["location", "audio", "fetch"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "life.executor.health"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用你当前位置查天气、空气质量,给出更贴合的建议",
          "locationAlwaysAndWhenInUsePermission": "跑步过程中需要后台定位才能持续记录路线和配速",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      "./plugins/withRokidIosPods",
      "./plugins/withRokidIosAuthCallback",
      [
        "expo-notifications",
        {
          "color": "#0A8F8F"
        }
      ],
      "./plugins/withIntentsExtension",
      "@sentry/react-native",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "./plugins/withHealthKitCleanup",
      "./plugins/withRokidPushupApk",
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false,
          "healthSharePermission": "用于读取 Apple Watch / RingConn / Oura 等设备的健康数据"
        }
      ],
      "./plugins/withWatchApp",
      "./plugins/withIosSupportedOrientations"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "911ea84f-bc7e-4a12-90cf-33966b6f7398",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "RevaWatch",
                  "bundleIdentifier": "life.executor.health.watchkitapp",
                  "entitlements": {}
                },
                {
                  "targetName": "RevaComplication",
                  "bundleIdentifier": "life.executor.health.watchkitapp.watchkitextension",
                  "parentBundleIdentifier": "life.executor.health.watchkitapp",
                  "entitlements": {}
                }
              ]
            }
          }
        }
      }
    },
    "owner": "itsoso",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/911ea84f-bc7e-4a12-90cf-33966b6f7398"
    }
  }
}
