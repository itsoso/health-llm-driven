{
  "expo": {
    "name": "小巴健康",
    "slug": "health-pilot",
    "version": "1.3.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["mobile", "health"],
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#D57953"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "life.executor.health",
      "entitlements": {
        "aps-environment": "production",
        "com.apple.developer.healthkit": true
      },
      "infoPlist": {
        "CFBundleDisplayName": "小巴健康",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "NSFaceIDUsageDescription": "使用 Face ID 保护您的健康数据",
        "NSPhotoLibraryUsageDescription": "用于你主动选择健康相关图片或生活照片，生成记录草稿、健康分析或足迹回顾",
        "NSPhotoLibraryAddUsageDescription": "用于你主动保存健康报告、截图或足迹分享图到照片图库",
        "NSCameraUsageDescription": "用于你主动拍摄食物、健康数据或生活照片，进行分析或记录足迹",
        "NSMicrophoneUsageDescription": "用于语音输入、健康记录听写和小巴对话",
        "NSSpeechRecognitionUsageDescription": "识别你的语音,和小巴连续对话",
        "NSLocationWhenInUseUsageDescription": "用于查询天气、空气质量；你主动选择时单次读取位置，确认城市后保存为记录足迹，不持续追踪",
        "NSHealthShareUsageDescription": "用于读取 Apple Watch / RingConn / Oura 等设备写入的健康数据,生成个性化健康分析",
        "ITSAppUsesNonExemptEncryption": false
      },
