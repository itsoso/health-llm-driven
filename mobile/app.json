{
  "expo": {
    "name": "HealthPilot",
    "slug": "health-pilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A8F8F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "life.executor.health",
      "infoPlist": {
        "NSFaceIDUsageDescription": "使用 Face ID 保护您的健康数据",
        "NSSiriUsageDescription": "使用 Siri 语音记录健康数据",
        "NSPhotoLibraryUsageDescription": "选择图片发送给 AI 助手分析",
        "NSCameraUsageDescription": "拍摄食物或健康数据进行分析",
        "NSMicrophoneUsageDescription": "使用语音输入",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "life.executor.health"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A8F8F"
        }
      ],
      "./plugins/withIntentsExtension"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "911ea84f-bc7e-4a12-90cf-33966b6f7398"
      }
    },
    "owner": "itsoso"
  }
}
