{
  "expo": {
    "name": "HealthPilot",
    "slug": "health-pilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A8F8F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.executor.healthpilot",
      "infoPlist": {
        "NSFaceIDUsageDescription": "使用 Face ID 保护您的健康数据"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A8F8F"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
