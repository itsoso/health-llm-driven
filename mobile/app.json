{
  "expo": {
    "name": "HealthPilot",
    "slug": "health-pilot",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["mobile", "health"],
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A8F8F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "life.executor.health",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "CFBundleDisplayName": "健康助理",
        "NSFaceIDUsageDescription": "使用 Face ID 保护您的健康数据",
        "NSSiriUsageDescription": "使用 Siri 语音快速记录或分析健康数据",
        "NSPhotoLibraryUsageDescription": "选择图片发送给 AI 助手分析",
        "NSCameraUsageDescription": "拍摄食物或健康数据进行分析",
        "NSMicrophoneUsageDescription": "使用语音输入",
        "NSSpeechRecognitionUsageDescription": "识别你的语音,和健康助理连续对话",
        "NSLocationWhenInUseUsageDescription": "用你当前位置查天气、空气质量,给出更贴合的建议",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "跑步过程中需要后台定位才能持续记录路线和配速,息屏 / 切换到其他 App 时不中断",
        "UIBackgroundModes": ["location", "audio"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "life.executor.health"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用你当前位置查天气、空气质量,给出更贴合的建议",
          "locationAlwaysAndWhenInUsePermission": "跑步过程中需要后台定位才能持续记录路线和配速",
          "isIosBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0A8F8F"
        }
      ],
      "./plugins/withIntentsExtension",
      "@sentry/react-native",
      "expo-font",
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "911ea84f-bc7e-4a12-90cf-33966b6f7398"
      }
    },
    "owner": "itsoso",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/911ea84f-bc7e-4a12-90cf-33966b6f7398"
    }
  }
}
