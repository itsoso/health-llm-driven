{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "development",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "preview",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "APP_VARIANT": "preview"
      }
    },
    "rokid-preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "preview",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "APP_VARIANT": "preview",
        "ROKID_IOS_SDK_ENABLED": "1",
        "ROKID_IOS_CLIENT_VERSION": "1.0.1",
        "ROKID_IOS_SIMULATOR": "0"
      }
    },
    "production": {
      "android": {
        "autoIncrement": true
      },
      "ios": {
        "autoIncrement": true
      },
      "channel": "production",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "APP_VARIANT": "production"
      }
    },
    "rokid-production": {
      "android": {
        "autoIncrement": true
      },
      "ios": {
        "autoIncrement": true
      },
      "channel": "production",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "APP_VARIANT": "production",
        "ROKID_IOS_SDK_ENABLED": "1",
        "ROKID_IOS_CLIENT_VERSION": "1.0.1",
        "ROKID_IOS_SIMULATOR": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6763569720"
      }
    }
  }
}
