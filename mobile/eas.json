{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "development",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "preview",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "APP_VARIANT": "preview"
      }
    },
    "rokid-preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "image": "latest"
      },
      "channel": "rokid-preview",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "APP_VARIANT": "preview",
        "ROKID_IOS_SDK_ENABLED": "1",
        "ROKID_IOS_CLIENT_FRAMEWORK_PATH": "vendor/RGCxrClient.framework",
        "ROKID_IOS_CLIENT_HAS_CALLBACK_API": "1",
        "ROKID_IOS_CLIENT_VERSION": "1.0.1",
        "ROKID_IOS_SIMULATOR": "0"
      }
    },
    "watch-preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "image": "latest"
      },
      "channel": "preview",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "APP_VARIANT": "preview",
        "INCLUDE_WATCH_APP": "1"
      }
    },
    "production": {
      "node": "22.13.0",
      "android": {
        "autoIncrement": true
      },
      "ios": {
        "autoIncrement": true
      },
      "channel": "production",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "APP_VARIANT": "production"
      }
    },
    "rokid-production": {
      "android": {
        "autoIncrement": true
      },
      "ios": {
        "autoIncrement": true,
        "image": "latest"
      },
      "channel": "rokid-production",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "APP_VARIANT": "production",
        "ROKID_IOS_SDK_ENABLED": "1",
        "ROKID_IOS_CALLBACK_SCHEME": "cxrl",
        "ROKID_IOS_CLIENT_FRAMEWORK_PATH": "vendor/RGCxrClient.framework",
        "ROKID_IOS_CLIENT_HAS_CALLBACK_API": "1",
        "ROKID_IOS_CLIENT_VERSION": "1.0.1",
        "ROKID_IOS_SIMULATOR": "0"
      }
    },
    "watch-production": {
      "android": {
        "autoIncrement": true
      },
      "ios": {
        "autoIncrement": true,
        "image": "latest"
      },
      "channel": "production",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "APP_VARIANT": "production",
        "INCLUDE_WATCH_APP": "1"
      }
    },
    "rokid-adhoc": {
      "extends": "rokid-production",
      "distribution": "internal"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6763569720"
      }
    },
    "production-no-groups": {
      "ios": {
        "ascAppId": "6763569720"
      }
    },
    "rokid-production": {
      "ios": {
        "ascAppId": "6763569720"
      }
    }
  }
}
