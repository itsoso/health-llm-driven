  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "node scripts/patch-react-native-voice-android.js && patch-package --error-on-fail",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "eas-build-post-install": "node scripts/eas-watch-postinstall.js",
    "lint": "expo lint",
    "design:check": "node scripts/check_design_tokens.js",
    "design:report": "node scripts/check_design_tokens.js --report --top",
    "generate-types": "cd ../backend && source venv/bin/activate && SKIP_DB_INIT=1 python3 -c 'import json; from main import app; json.dump(app.openapi(), open(\"/tmp/openapi.json\",\"w\"), ensure_ascii=False)' && cd ../mobile && npx openapi-typescript@7.13.0 /tmp/openapi.json -o types/api.generated.ts"
  },
