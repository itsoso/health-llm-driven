# ============================================
# 健康管理系统 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================

# 数据库配置
DATABASE_URL=sqlite:///./health.db

# JWT 密钥（生产环境必须设置，至少 32 字符）
SECRET_KEY=your-super-secret-key-change-in-production

# OpenAI API（用于 AI 健康分析）
OPENAI_API_KEY=sk-xxxxx

# 可选：OpenAI 代理地址（中国大陆用户）
# OPENAI_BASE_URL=https://api.openai-proxy.com/v1

# 可选：Garmin 凭证加密密钥
# GARMIN_ENCRYPTION_KEY=your-fernet-key

# 可选：设备凭证加密密钥
# DEVICE_ENCRYPTION_KEY=your-fernet-key

# CORS 允许来源（逗号分隔），为空则拒绝所有跨域
# CORS_ALLOW_ORIGINS=https://executor.life,https://health.executor.life

# Garmin 同步间隔（小时）
GARMIN_SYNC_INTERVAL_HOURS=2
