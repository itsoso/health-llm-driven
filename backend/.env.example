# ============================================
# 健康管理系统 - 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# ============================================

# Production systemd/deploy contract. For local-only development, set
# APP_ENV=development and remove the external runtime/storage overrides below.
APP_ENV=production
DEBUG=False
HEALTH_RUNTIME_DATA_DIR=/var/lib/health-app/runtime
HEALTH_UPLOAD_DIR=/var/lib/health-app/uploads
HEALTH_SKILLS_CACHE_DIR=/var/cache/health-app/skills-hub
LEGACY_KNOWLEDGE_RUNTIME_ENABLED=false

# === LLM Provider Configuration ===
# Provider: openai | ollama | openclaw
LLM_PROVIDER=openai

# For OpenAI / DeepSeek / any OpenAI-compatible API:
LLM_API_KEY=sk-your-api-key
# LLM_BASE_URL=https://api.openai.com/v1  # Optional: proxy or custom endpoint
LLM_MODEL=gpt-4o-mini
LLM_VISION_MODEL=qwen3-vl-flash

# ============================================
# 阿里云百炼 Wan AIGC（可选）
# 必须使用独立的百炼按量 API Key；Token Plan / Coding Plan 的订阅 Key 仅供文本
# 模型使用，不能用于图片或短视频生成。
# ============================================
# DASHSCOPE_AIGC_API_KEY=
# DASHSCOPE_AIGC_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# DASHSCOPE_AIGC_IMAGE_MODEL=wan2.7-image
# DASHSCOPE_AIGC_TEXT_TO_VIDEO_MODEL=wan2.7-t2v
# DASHSCOPE_AIGC_IMAGE_TO_VIDEO_MODEL=wan2.7-i2v
# DASHSCOPE_AIGC_MAX_ACTIVE_JOBS_PER_USER=2
# DASHSCOPE_AIGC_MAX_ACTIVE_JOBS_GLOBAL=20
# DASHSCOPE_AIGC_MAX_DISPATCHES_PER_USER_PER_DAY=5
# DASHSCOPE_AIGC_POLL_MIN_INTERVAL_SECONDS=6
# DASHSCOPE_AIGC_GLOBAL_POLL_MIN_INTERVAL_SECONDS=1
# 图生短视频时，后端会从这个公网 HTTPS 根地址生成短时效源图链接。
# SITE_BASE_URL=https://health.example.com

# For Ollama (local models):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# For OpenClaw multi-model analysis (optional):
# OPENCLAW_ANALYZE_URL=https://your-openclaw/api/openclaw/analyze
# OPENCLAW_ANALYZE_API_KEY=your-key
# OPENCLAW_ANALYZE_USER_ID=your-user-id

# 数据库配置（开发/生产统一使用 PostgreSQL; SQLite 仅保留给少量显式单元测试）
DATABASE_URL=postgresql://health_user:your-postgres-password@localhost:5432/health_db
# 可选: pytest 使用真实 PostgreSQL 语义时设置, 库名必须包含 test
# TEST_DATABASE_URL=postgresql://health_user:your-postgres-password@localhost:5432/health_test

# PostgreSQL 配置（生产环境推荐）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=health_db
POSTGRES_USER=health_user
POSTGRES_PASSWORD=your-postgres-password

# 生产发布闸门：没有 Sentry 或 TokenPlan 月额度时，release-readiness 会阻断发布
SENTRY_DSN=
TOKENPLAN_MONTHLY_TOKEN_QUOTA=0
LLM_AUTO_RECOVERY_ENABLED=false
LLM_RECOVERY_MODEL_ID=

# JWT 密钥（生产环境必须设置，至少 32 字符）
SECRET_KEY=your-super-secret-key-change-in-production

# OpenAI API（用于 AI 健康分析）
OPENAI_API_KEY=sk-xxxxx

# 可选：OpenAI 代理地址（中国大陆用户）
# OPENAI_BASE_URL=https://api.openai-proxy.com/v1

# System KB pgvector semantic search（可选；不可用时自动回退 sparse 检索）
SYSTEM_KB_PGVECTOR_ENABLED=true
# 可选：System KB 专用 embedding provider；留空则回退 OPENAI_API_KEY / OPENAI_BASE_URL
# SYSTEM_KB_EMBEDDING_API_KEY=your-embedding-api-key
# SYSTEM_KB_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SYSTEM_KB_EMBEDDING_MODEL=text-embedding-3-small
SYSTEM_KB_EMBEDDING_DIMENSIONS=1536
SYSTEM_KB_EMBEDDING_BATCH_SIZE=50

# dedao-kbase immutable Release consumer. The review workspace must live
# outside the deployed Git checkout so pending drafts survive deployments.
# DEDAO_KBASE_RELEASE_BASE_URL=https://kbase.example.com
# DEDAO_KBASE_AUTH_TOKEN=
DEDAO_KBASE_REVIEW_ARTIFACT_DIR=/var/lib/health-app/dedao-kbase/workspace

# ============================================
# OpenClaw AI 对话服务
# ============================================
OPENCLAW_BASE_URL=https://bot.executor.life/v1
OPENCLAW_API_KEY=your-openclaw-gateway-token
OPENCLAW_MODEL=openclaw:main

# ============================================
# LangBridge Gateway (browser-llm-orchestrator 代理商用模型)
# 透明使用 Claude / GPT / Gemini, 含 vision 能力.
# 模型 id (注册在 model_registry.py, admin / user_profile.llm_model_id 切换):
#   claude-opus-4.7   gpt-5.5   gemini-3.1-pro
# 留空 = 这三个 entry 在 list_models(only_available=True) 里被自动过滤掉.
# ============================================
LANGBRIDGE_GATEWAY_BASE_URL=https://base.executor.life/api/llm
LANGBRIDGE_GATEWAY_API_KEY=

# ============================================
# 加密密钥配置（重要！生产环境必须设置）
# ============================================
# 注意：以下加密密钥必须独立生成，不能从 SECRET_KEY 派生
# 生成方法：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Garmin 凭证加密密钥（用于加密存储的 Garmin 密码）
# 生产环境必须设置！开发环境也建议设置
GARMIN_ENCRYPTION_KEY=

# 设备凭证加密密钥（用于统一加密各类设备凭证）
# 生产环境必须设置！
DEVICE_ENCRYPTION_KEY=

# ============================================
# CORS 跨域配置（重要！生产环境必须配置）
# ============================================
# CORS 允许来源（逗号分隔）
# - 为空：拒绝所有跨域请求（最安全）
# - 生产环境：必须明确指定允许的域名
# - 开发环境：可以添加 http://localhost:3000 等
#
# 示例：
# CORS_ALLOW_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# 开发环境示例：
# CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOW_ORIGINS=

# Garmin 同步间隔（小时）
GARMIN_SYNC_INTERVAL_HOURS=2

# ============================================
# Withings 体重秤/智能手表配置
# ============================================
# 在 Withings 开发者平台获取: https://developer.withings.com/
WITHINGS_CLIENT_ID=your-withings-client-id
WITHINGS_CLIENT_SECRET=your-withings-client-secret

# ============================================
# 华为 Health Kit 配置
# ============================================
# 在华为开发者联盟获取: https://developer.huawei.com/consumer/cn/hms/huaweihealth/
HUAWEI_CLIENT_ID=your-huawei-client-id
HUAWEI_CLIENT_SECRET=your-huawei-client-secret

# ============================================
# 微信小程序配置
# ============================================
# 小程序基本信息（在微信公众平台获取）
WECHAT_APPID=wx1234567890abcdef
WECHAT_SECRET=your-wechat-secret-here

# 微信订阅消息模板ID（在微信公众平台申请订阅消息模板后获取）
WECHAT_TEMPLATE_REMINDER=your-reminder-template-id
WECHAT_TEMPLATE_BRIEFING=your-briefing-template-id
WECHAT_TEMPLATE_ALERT=your-alert-template-id
WECHAT_TEMPLATE_GOAL=your-goal-template-id
WECHAT_TEMPLATE_WEEKLY=your-weekly-template-id
# 邀请制手机号注册 rollout 四态：
# - false/false = legacy_only：不安全开放旧注册，仅本地/短期兼容
# - true/false = ota_compatibility：OTA 兼容窗，旧版 Mobile 暂可自动建号
# - true/true = enforced：生产完全强制邀请制注册
# - false/true = rollback_closed：安全回滚，关闭所有新注册但保留老用户登录
# 禁止把 enforcement=false 当作生产回滚方案。
REGISTRATION_INVITATION_ROLLOUT_ENABLED=false
REGISTRATION_INVITATION_ENFORCEMENT_ENABLED=false
# 生产启用 rollout 或 enforcement 时必须使用至少 32 UTF-8 bytes 的独立随机 key。
REGISTRATION_INVITATION_DIGEST_KEY=

# 邀请短信生产必需配置。专用 key 为空时复用 ALIYUN_ACCESS_KEY_ID/SECRET；
# 若填写专用 key，则 ID 与 SECRET 必须成对设置。以下均为占位空值，不放真实凭据。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
# 邀请短信必须使用独立审核过的签名/模板，不复用 OTP 签名或模板。
# 若 OTP 使用阿里云短信，这两个变量是对比基准；生产邀请值不得与其相同。
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
REGISTRATION_INVITATION_SMS_SIGN_NAME=
REGISTRATION_INVITATION_SMS_TEMPLATE_CODE=
