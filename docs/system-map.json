{
  "schema_version": 1,
  "system": {
    "name": "Reva Personal Health OS",
    "goal": "Turn fragmented personal health data into safe, high-leverage actions that users can execute daily and verify over time.",
    "north_star_metric": "Weekly completed high-leverage health actions that passed safety gating and have an attached verification plan."
  },
  "authority": [
    "AGENTS.md",
    "docs/specs/reva-product-governance-spec.md",
    "docs/specs/product-pipeline-contract.md",
    "docs/prd/reva-personal-health-os-prd.md",
    "docs/ARCHITECTURE.md"
  ],
  "surfaces": [
    {
      "id": "backend",
      "role": "Source of truth for Health Twin, Safety Gate, Agenda, WriteIntent, audit, and data ownership.",
      "paths": [
        "backend/app",
        "backend/tests"
      ]
    },
    {
      "id": "mobile",
      "role": "Primary daily product for Today, Agenda, Capture, Programs, Review, and consent/settings.",
      "paths": [
        "mobile/app",
        "mobile/services",
        "mobile/hooks"
      ]
    },
    {
      "id": "watch",
      "role": "Low-friction execution and quick capture surface for top action, due item, voice, and fast records.",
      "paths": [
        "apps/watch",
        "mobile/native/watch"
      ]
    },
    {
      "id": "mac",
      "role": "Workbench for import, long agent workflows, trace review, file handling, and release operations.",
      "paths": [
        "apps/mac"
      ]
    },
    {
      "id": "web",
      "role": "Admin, history, doctor/family, report, and compatibility surface.",
      "paths": [
        "frontend/src/app"
      ]
    },
    {
      "id": "external-agents",
      "role": "Controlled extension through OpenClaw skills and MCP with auth, audit, and safety boundaries.",
      "paths": [
        "openclaw-skills",
        "backend/skills",
        "mcp-server"
      ]
    },
    {
      "id": "docs-agent",
      "role": "Agent-readable governance, product, architecture, workflow, and system transparency layer.",
      "paths": [
        "AGENTS.md",
        ".claude/skills",
        "docs"
      ]
    }
  ],
