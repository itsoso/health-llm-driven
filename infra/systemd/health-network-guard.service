[Unit]
Description=Health application egress boundary protecting colocated staking
After=network-pre.target
Before=health-backend.service celery-worker.service celery-beat.service health-frontend.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I -B /opt/health-app/scripts/harden_public_host.py --network
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
