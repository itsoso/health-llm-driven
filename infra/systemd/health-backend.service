[Unit]
Description=Health FastAPI backend
Requires=health-backend.socket
After=network-online.target health-backend.socket postgresql.service redis-server.service

[Service]
Type=simple
User=health-app
Group=health-app
WorkingDirectory=/opt/health-app/backend
EnvironmentFile=/opt/health-app/backend/.env
Environment=PATH=/opt/health-app/backend/venv/bin:/usr/bin
# Garmin 0.3.6 MFA challenge 持有进程内 native HTTP client；在 durable
# challenge coordinator 落地前必须保持单 worker，避免验证码请求随机换进程。
ExecStart=/opt/health-app/backend/venv/bin/uvicorn main:app --fd 3 --workers 1 --limit-concurrency 100 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log --timeout-graceful-shutdown 30
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM
RestartKillSignal=SIGTERM
SendSIGKILL=yes
FinalKillSignal=SIGKILL
# Keep request-owned Pi children alive while the single worker drains.
KillMode=mixed

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/var/lib/health-app/uploads /var/cache/health-app/skills-hub /var/lib/health-app/runtime /var/lib/health-app/dedao-kbase

# Public application processes must not reach staking material or cloud metadata.
InaccessiblePaths=-/mnt -/opt/eth-ops
IPAddressDeny=100.64.0.0/10 169.254.0.0/16
CapabilityBoundingSet=
MemoryMax=2G
CPUQuota=200%
TasksMax=512

[Install]
WantedBy=multi-user.target
