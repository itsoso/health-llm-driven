[Unit]
Description=Health FastAPI backend
Requires=health-backend.socket
After=network-online.target health-backend.socket postgresql.service redis-server.service

[Service]
Type=simple
User=health-app
Group=health-app
WorkingDirectory=/opt/health-app/backend
EnvironmentFile=/opt/health-app/backend/.env
Environment=PATH=/opt/health-app/backend/venv/bin:/usr/bin
ExecStart=/opt/health-app/backend/venv/bin/uvicorn main:app --fd 3 --workers 2 --limit-concurrency 100 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
UMask=0077
ReadWritePaths=/opt/health-app/backend/logs /opt/health-app/backend/uploads /opt/health-app/backend/data /opt/health-app/backend/private_media /opt/health-app/.health-skills-cache

[Install]
WantedBy=multi-user.target
