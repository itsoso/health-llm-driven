#!/bin/sh

# This tracked wrapper could generate a signed native APK. The implementation
# is intentionally removed until a repository-external release Gate owns native
# build, signing, and install authority.
#
# BASH_SOURCE is set by the hostile-source regression. Ordinary /bin/sh
# execution does not define it, so the tombstone still returns EX_CONFIG (78).
if [ -z "${BASH_SOURCE+x}" ] || [ "${BASH_SOURCE:-}" = "$0" ]; then
    printf '%s\n' \
        'Rokid native build/sign/install entrypoint is frozen; use the manual external Gate.' >&2
    exit 78
fi
